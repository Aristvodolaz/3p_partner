generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Partner {
  id                 Int                @id @default(autoincrement())
  name               String             @db.NVarChar(255)
  inn                String             @db.NVarChar(12)
  contractNumber     String             @db.NVarChar(100)
  contactPerson      String             @db.NVarChar(255)
  phone              String             @db.NVarChar(20)
  email              String             @db.NVarChar(255)
  paymentTerms       String             @db.NVarChar(Max)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now()) @db.DateTime2
  updatedAt          DateTime           @updatedAt @db.DateTime2
  history            PartnerHistory[]
  skus               Sku[]
  tariffs            PartnerTariff[]
  tariffHistory      TariffHistory[]
  requests           PartnerRequest[]
  acts               Act[]
  incomingDeliveries IncomingDelivery[]
  outgoingDeliveries OutgoingDelivery[]
  inventoryTasks     InventoryTask[]

  @@map("Partners")
}

model PartnerRequest {
  id          Int                 @id @default(autoincrement())
  partnerId   Int
  number      String              @unique @db.NVarChar(100)
  status      String              @default("Запланировано") @db.NVarChar(50)
  requestDate DateTime?           @db.DateTime2
  comment     String?             @db.NVarChar(Max)
  createdAt   DateTime            @default(now()) @db.DateTime2
  updatedAt   DateTime            @updatedAt @db.DateTime2
  partner     Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  items       RequestItem[]
  receipts    Receipt[]
  shipments   Shipment[]
  documents   WarehouseDocument[]

  @@index([partnerId])
  @@map("PartnerRequests")
}

model RequestItem {
  id               Int                      @id @default(autoincrement())
  requestId        Int
  skuId            Int?
  article          String                   @db.NVarChar(100)
  name             String?                  @db.NVarChar(500)
  quantity         Int
  factQuantity     Int?
  actualArticle    String?                  @db.NVarChar(100)
  arrivalDate      DateTime?                @db.DateTime2
  shipmentDate     DateTime?                @db.DateTime2
  unitCost         Decimal?                 @db.Decimal(12, 2)
  totalCost        Decimal?                 @db.Decimal(14, 2)
  request          PartnerRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sku              Sku?                     @relation(fields: [skuId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  executions       ItemOperationExecution[]
  receiptItems     ReceiptItem[]
  packingUnits     PackingUnit[]
  packingUnitItems PackingUnitItem[]

  @@index([requestId])
  @@map("RequestItems")
}

model Receipt {
  id         Int            @id @default(autoincrement())
  requestId  Int
  type       String         @db.NVarChar(20) // PALLET | BOX | UNIT
  isPartial  Boolean        @default(false)
  receivedBy String         @db.NVarChar(255)
  comment    String?        @db.NVarChar(Max)
  createdAt  DateTime       @default(now()) @db.DateTime2
  request    PartnerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  items      ReceiptItem[]

  @@index([requestId])
  @@map("Receipts")
}

model ReceiptItem {
  id                 Int          @id @default(autoincrement())
  receiptId          Int
  requestItemId      Int?
  article            String       @db.NVarChar(100)
  expectedQty        Int
  acceptedQty        Int
  discrepancyType    String?      @db.NVarChar(30) // QUALITY | NAME | QUANTITY | PACKAGING | DEFECT
  discrepancyComment String?      @db.NVarChar(Max)
  receipt            Receipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  requestItem        RequestItem? @relation(fields: [requestItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([receiptId])
  @@map("ReceiptItems")
}

model StorageMovement {
  id                     Int       @id @default(autoincrement())
  partnerId              Int
  article                String    @db.NVarChar(100)
  requestItemId          Int?
  address                String    @db.NVarChar(100) // денормализованный код адреса — снимок на момент движения
  addressId              Int? // без @relation — см. IncomingDeliveryItemId ниже и sourceIncomingDeliveryId у OutgoingDelivery
  zoneType               String?   @db.NVarChar(10) // I | S | W | O — снимок типа зоны адреса на момент движения
  quantity               Int // положительное — приход на адрес, отрицательное — списание
  type                   String    @db.NVarChar(20) // PLACE | REMOVE | MOVE_OUT | MOVE_IN | ADJUST
  // "Партия поступления" — ссылка на конкретную позицию ВХП, без @relation по
  // той же причине, что и остальные информационные ссылки в этом файле
  // (SQL Server multiple cascade paths через Partner). receivedAt — снимок
  // даты приёмки, ключ сортировки для FIFO-подбора при создании ИСП.
  incomingDeliveryItemId Int?
  receivedAt             DateTime? @db.DateTime2
  // Источник движения — для истории и трассировки (п.12 ТЗ по остаткам).
  docType                String?   @db.NVarChar(20) // INCOMING | MOVEMENT_TASK | INVENTORY | null (ручная операция ТСД)
  docId                  Int?
  comment                String?   @db.NVarChar(Max)
  createdBy              String    @db.NVarChar(255)
  createdAt              DateTime  @default(now()) @db.DateTime2

  @@index([partnerId, article])
  @@index([address])
  @@index([incomingDeliveryItemId])
  @@map("StorageMovements")
}

// ---------------------------------------------------------------------
// Остатки товара на складе: зоны, адреса, задания на перемещение (FIFO).
// ---------------------------------------------------------------------

/// Справочник зон склада: I — приёмка, S — хранение, W — обработка, O — отгрузка.
model WarehouseZone {
  id            Int              @id @default(autoincrement())
  code          String           @unique @db.NVarChar(50)
  name          String           @db.NVarChar(255)
  type          String           @db.NVarChar(10) // I | S | W | O
  warehouseCode String?          @db.NVarChar(100)
  createdAt     DateTime         @default(now()) @db.DateTime2
  addresses     StorageAddress[]

  @@map("WarehouseZones")
}

/// Справочник адресов хранения — каждый адрес принадлежит ровно одной зоне
/// (и наследует её тип на момент движения через StorageMovement.zoneType).
model StorageAddress {
  id            Int           @id @default(autoincrement())
  code          String        @unique @db.NVarChar(100)
  zoneId        Int
  warehouseCode String?       @db.NVarChar(100)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now()) @db.DateTime2
  zone          WarehouseZone @relation(fields: [zoneId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([zoneId])
  @@map("StorageAddresses")
}

/// Задание на перемещение S→W, формируется автоматически при создании ИСП
/// по принципу FIFO (п.7-9 ТЗ по остаткам). Статусы — та же четвёрка, что у
/// ВХП/ИСП/Инвентаризации, через общий DocumentNumberingService/StatusChange.
model MovementTask {
  id                 Int                @id @default(autoincrement())
  number             String             @unique @db.NVarChar(50) // "ПРМ-123"
  // Без @relation — как sourceIncomingDeliveryId у OutgoingDelivery: чисто
  // информационная ссылка на ИСП, породившую задание.
  outgoingDeliveryId Int?
  partnerId          Int // тоже без @relation — иначе ещё один каскадный путь через Partner
  status             String             @default("Создана") @db.NVarChar(20)
  createdBy          String             @db.NVarChar(255)
  createdAt          DateTime           @default(now()) @db.DateTime2
  updatedAt          DateTime           @updatedAt @db.DateTime2
  items              MovementTaskItem[]

  @@index([outgoingDeliveryId])
  @@map("MovementTasks")
}

model MovementTaskItem {
  id                     Int          @id @default(autoincrement())
  taskId                 Int
  article                String       @db.NVarChar(100)
  name                   String?      @db.NVarChar(500)
  // Все ссылки ниже — информационные Int без @relation (тот же приём, что и
  // везде в этом файле для полей, торчащих в сторону Partner-графа).
  skuId                  Int?
  outgoingDeliveryItemId Int?
  sourceAddressId        Int? // адрес-источник в зоне S, подобранный по FIFO
  incomingDeliveryItemId Int? // партия-источник
  targetAddressId        Int? // адрес в зоне W, куда фактически переместили (заполняется при подтверждении)
  quantity               Int
  status                 String       @default("Ожидает") @db.NVarChar(20) // Ожидает | Перемещено
  confirmedBy            String?      @db.NVarChar(255)
  confirmedAt            DateTime?    @db.DateTime2
  task                   MovementTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("MovementTaskItems")
}

model Shipment {
  id          Int            @id @default(autoincrement())
  requestId   Int
  method      String         @db.NVarChar(20) // SELF | PARTNER
  vehicleInfo String?        @db.NVarChar(255)
  driverName  String?        @db.NVarChar(255)
  plannedDate DateTime?      @db.DateTime2
  shippedAt   DateTime?      @db.DateTime2
  shippedBy   String?        @db.NVarChar(255)
  comment     String?        @db.NVarChar(Max)
  createdAt   DateTime       @default(now()) @db.DateTime2
  request     PartnerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  items       ShipmentItem[]

  @@index([requestId])
  @@map("Shipments")
}

model ShipmentItem {
  id         Int      @id @default(autoincrement())
  shipmentId Int
  article    String   @db.NVarChar(100)
  name       String?  @db.NVarChar(500)
  quantity   Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("ShipmentItems")
}

model WarehouseDocument {
  id        Int            @id @default(autoincrement())
  requestId Int
  type      String         @db.NVarChar(20) // MX1 | TORG2 | TTN | MX3
  number    String         @db.NVarChar(100)
  data      String         @db.NVarChar(Max) // JSON-снимок данных на момент формирования
  createdBy String         @db.NVarChar(255)
  createdAt DateTime       @default(now()) @db.DateTime2
  request   PartnerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("WarehouseDocuments")
}

model ItemOperationExecution {
  id            Int         @id @default(autoincrement())
  requestItemId Int
  operationId   Int
  done          Boolean     @default(false)
  factQty       Int?
  isDefect      Boolean     @default(false)
  comment       String?     @db.NVarChar(Max)
  executedBy    String?     @db.NVarChar(255)
  executedAt    DateTime?   @db.DateTime2
  item          RequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  operation     Operation   @relation(fields: [operationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([requestItemId, operationId])
  @@index([requestItemId])
  @@map("ItemOperationExecutions")
}

model PartnerTariff {
  id          Int       @id @default(autoincrement())
  partnerId   Int
  operationId Int
  tariff      Decimal   @db.Decimal(10, 2)
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  operation   Operation @relation(fields: [operationId], references: [id])

  @@unique([partnerId, operationId])
  @@map("PartnerTariffs")
}

model Operation {
  id                             Int                             @id @default(autoincrement())
  code                           String                          @unique @db.NVarChar(50)
  name                           String                          @db.NVarChar(255)
  description                    String?                         @db.NVarChar(Max)
  unit                           String?                         @db.NVarChar(100)
  tariff                         Decimal?                        @db.Decimal(10, 2)
  applySizeCoef                  Boolean                         @default(false)
  sortOrder                      Int                             @default(0)
  // К какому документу операция относится по умолчанию: ВХП (приёмка) —
  // INCOMING, ИСП (обработка/отгрузка) — OUTGOING, или обеим — BOTH.
  // Существующие операции по умолчанию OUTGOING — сохраняет их нынешнее
  // поведение (это уже был чек-лист SKU для исходящей обработки).
  phase                          String                          @default("OUTGOING") @db.NVarChar(10)
  skuOperations                  SkuOperation[]
  partnerTariffs                 PartnerTariff[]
  tariffHistory                  TariffHistory[]
  executions                     ItemOperationExecution[]
  outgoingDeliveryItemOperations OutgoingDeliveryItemOperation[]

  @@map("OperationsCatalog")
}

model TariffCoefficient {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.NVarChar(10)
  multiplier Decimal  @db.Decimal(6, 2)
  minSum     Decimal  @db.Decimal(10, 2)
  maxSum     Decimal? @db.Decimal(10, 2)
  label      String   @db.NVarChar(100)

  @@map("TariffCoefficients")
}

model TariffHistory {
  id          Int       @id @default(autoincrement())
  partnerId   Int
  operationId Int
  changedBy   String    @db.NVarChar(255)
  oldTariff   Decimal?  @db.Decimal(10, 2)
  newTariff   Decimal?  @db.Decimal(10, 2)
  changedAt   DateTime  @default(now()) @db.DateTime2
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  operation   Operation @relation(fields: [operationId], references: [id])

  @@index([partnerId])
  @@map("TariffHistory")
}

model Sku {
  id                    Int                    @id @default(autoincrement())
  partnerId             Int
  article               String                 @db.NVarChar(100)
  barcode               String?                @db.NVarChar(100)
  name                  String                 @db.NVarChar(500)
  color                 String?                @db.NVarChar(100)
  shelfLife             String?                @db.NVarChar(100)
  sumOfSides            Decimal?               @db.Decimal(10, 2)
  weight                Decimal?               @db.Decimal(10, 3)
  clientRequirements    String?                @db.NVarChar(Max)
  specialMarks          String?                @db.NVarChar(500)
  boxQuant              Int?
  palletQuant           Int?
  packCostUnit          Decimal?               @db.Decimal(10, 2)
  packCostBox           Decimal?               @db.Decimal(10, 2)
  allowMixedBox         Boolean                @default(false)
  createdAt             DateTime               @default(now()) @db.DateTime2
  updatedAt             DateTime               @updatedAt @db.DateTime2
  partner               Partner                @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  operations            SkuOperation[]
  photos                SkuPhoto[]
  requestItems          RequestItem[]
  incomingDeliveryItems IncomingDeliveryItem[]
  outgoingDeliveryItems OutgoingDeliveryItem[]
  inventoryTaskItems    InventoryTaskItem[]

  @@unique([partnerId, article])
  @@index([partnerId])
  @@map("Skus")
}

model SkuOperation {
  id          Int       @id @default(autoincrement())
  skuId       Int
  operationId Int
  value       String?   @db.NVarChar(100)
  sku         Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  operation   Operation @relation(fields: [operationId], references: [id])

  @@unique([skuId, operationId])
  @@map("SkuOperations")
}

model SkuPhoto {
  id       Int    @id @default(autoincrement())
  skuId    Int
  filename String @db.NVarChar(500)
  sku      Sku    @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([skuId])
  @@map("SkuPhotos")
}

model PackingUnit {
  id             Int               @id @default(autoincrement())
  requestItemId  Int
  type           String            @db.NVarChar(10) // BOX | PALLET
  code           String            @db.NVarChar(100) // ШК ВПС / номер паллеты
  parentPalletId Int?
  expiryDate     DateTime?         @db.DateTime2
  nestingQty     Int?
  status         String            @default("IN_PROGRESS") @db.NVarChar(20) // IN_PROGRESS | COMPLETED
  createdBy      String            @db.NVarChar(255)
  createdAt      DateTime          @default(now()) @db.DateTime2
  completedAt    DateTime?         @db.DateTime2
  item           RequestItem       @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  parentPallet   PackingUnit?      @relation("PalletBoxes", fields: [parentPalletId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  boxes          PackingUnit[]     @relation("PalletBoxes")
  items          PackingUnitItem[]

  @@index([requestItemId])
  @@index([parentPalletId])
  @@map("PackingUnits")
}

model PackingUnitItem {
  id            Int         @id @default(autoincrement())
  packingUnitId Int
  requestItemId Int
  article       String      @db.NVarChar(100)
  quantity      Int
  isDefect      Boolean     @default(false)
  comment       String?     @db.NVarChar(Max)
  packingUnit   PackingUnit @relation(fields: [packingUnitId], references: [id], onDelete: Cascade)
  requestItem   RequestItem @relation(fields: [requestItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([packingUnitId])
  @@map("PackingUnitItems")
}

model Act {
  id          Int          @id @default(autoincrement())
  partnerId   Int
  type        String       @db.NVarChar(20) // REQUEST | ON_DEMAND | MONTHLY
  periodLabel String?      @db.NVarChar(20) // напр. "2026-08" для MONTHLY
  totalAmount Decimal      @db.Decimal(14, 2)
  data        String       @db.NVarChar(Max) // JSON-снимок построчной разбивки
  createdBy   String       @db.NVarChar(255)
  createdAt   DateTime     @default(now()) @db.DateTime2
  partner     Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  requests    ActRequest[]

  @@index([partnerId])
  @@map("Acts")
}

model ActRequest {
  id            Int     @id @default(autoincrement())
  actId         Int
  requestId     Int
  requestNumber String  @db.NVarChar(100)
  amount        Decimal @db.Decimal(14, 2)
  // Заявка (PartnerRequest, архив) или ИСП (OutgoingDelivery, актуальный
  // источник биллинга) — какая именно, определяет docType; requestId в
  // обоих случаях хранит id соответствующей таблицы, не FK на PartnerRequest.
  docType       String  @default("REQUEST") @db.NVarChar(20) // REQUEST (архив) | OUTGOING
  act           Act     @relation(fields: [actId], references: [id], onDelete: Cascade)

  @@index([actId])
  @@map("ActRequests")
}

model Employee {
  id         Int       @id @default(autoincrement())
  employeeId String    @unique @db.NVarChar(50) // ШК / табельный номер сотрудника во внешней системе
  fullName   String    @db.NVarChar(255)
  role       String?   @db.NVarChar(10) // НПП | НРП | null (не назначена)
  isActive   Boolean   @default(true)
  lastLogin  DateTime? @db.DateTime2
  createdAt  DateTime  @default(now()) @db.DateTime2
  updatedAt  DateTime  @updatedAt @db.DateTime2

  @@map("Employees")
}

model PartnerHistory {
  id        Int      @id @default(autoincrement())
  partnerId Int
  changedBy String   @db.NVarChar(255)
  fieldName String   @db.NVarChar(100)
  oldValue  String?  @db.NVarChar(Max)
  newValue  String?  @db.NVarChar(Max)
  changedAt DateTime @default(now()) @db.DateTime2
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("PartnerHistory")
}

// ---------------------------------------------------------------------
// ВХП / ИСП / Инвентаризация — см. Документ5.docx. Заменяют PartnerRequest
// (та остаётся в БД как архив без миграции, см. requests-модуль).
// ---------------------------------------------------------------------

/// Сквозная нумерация по типу документа: lastNumber инкрементится атомарно.
model DocumentCounter {
  docType    String @id @db.NVarChar(20) // INCOMING | OUTGOING | INVENTORY | MOVEMENT
  lastNumber Int    @default(0)

  @@map("DocumentCounters")
}

/// История статусов: кто, когда, на какой статус перевёл документ. Общая для всех типов документов.
model StatusChange {
  id        Int      @id @default(autoincrement())
  docType   String   @db.NVarChar(20) // INCOMING | OUTGOING | INVENTORY | MOVEMENT
  docId     Int
  status    String   @db.NVarChar(50)
  changedBy String   @db.NVarChar(255)
  changedAt DateTime @default(now()) @db.DateTime2

  @@index([docType, docId])
  @@map("StatusChanges")
}

/// ВХП — заявка на входящую поставку.
model IncomingDelivery {
  id            Int                    @id @default(autoincrement())
  number        String                 @unique @db.NVarChar(50) // "ВХП-123"
  partnerId     Int
  warehouseCode String?                @db.NVarChar(100)
  isCrossDock   Boolean                @default(false)
  status        String                 @default("Создана") @db.NVarChar(20)
  plannedDate   DateTime?              @db.DateTime2
  actualDate    DateTime?              @db.DateTime2 // проставляется автоматически при первой приёмке
  comment       String?                @db.NVarChar(Max)
  createdBy     String                 @db.NVarChar(255)
  createdAt     DateTime               @default(now()) @db.DateTime2
  updatedAt     DateTime               @updatedAt @db.DateTime2
  partner       Partner                @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  items         IncomingDeliveryItem[]

  @@index([partnerId])
  @@map("IncomingDeliveries")
}

model IncomingDeliveryItem {
  id           Int              @id @default(autoincrement())
  deliveryId   Int
  skuId        Int?
  article      String           @db.NVarChar(100)
  name         String?          @db.NVarChar(500)
  barcode      String?          @db.NVarChar(100)
  quantity     Int
  factQuantity Int?
  weight       Decimal?         @db.Decimal(10, 3)
  volume       Decimal?         @db.Decimal(10, 3)
  delivery     IncomingDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  sku          Sku?             @relation(fields: [skuId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([deliveryId])
  @@map("IncomingDeliveryItems")
}

/// ИСП — заявка на исходящую поставку.
model OutgoingDelivery {
  id                       Int                    @id @default(autoincrement())
  number                   String                 @unique @db.NVarChar(50) // "ИСП-123"
  partnerId                Int
  warehouseCode            String?                @db.NVarChar(100)
  isCrossDock              Boolean                @default(false)
  // Без FK-связи (как StorageMovement.requestItemId в этом же файле) — это
  // чисто информационная трассировка "создано автоматически из ВХП X по
  // КД", а не структурная зависимость. С FK любое из направлений (Cascade
  // или SetNull) даёт SQL Server multiple-cascade-paths через Partner →
  // IncomingDelivery/OutgoingDelivery одновременно.
  sourceIncomingDeliveryId Int?
  status                   String                 @default("Создана") @db.NVarChar(20)
  shipDate                 DateTime?              @db.DateTime2
  actualDate               DateTime?              @db.DateTime2
  comment                  String?                @db.NVarChar(Max)
  createdBy                String                 @db.NVarChar(255)
  createdAt                DateTime               @default(now()) @db.DateTime2
  updatedAt                DateTime               @updatedAt @db.DateTime2
  partner                  Partner                @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  items                    OutgoingDeliveryItem[]

  @@index([partnerId])
  @@index([sourceIncomingDeliveryId])
  @@map("OutgoingDeliveries")
}

model OutgoingDeliveryItem {
  id           Int                             @id @default(autoincrement())
  deliveryId   Int
  skuId        Int?
  article      String                          @db.NVarChar(100)
  name         String?                         @db.NVarChar(500)
  quantity     Int
  factQuantity Int?
  weight       Decimal?                        @db.Decimal(10, 3)
  volume       Decimal?                        @db.Decimal(10, 3)
  unitCost     Decimal?                        @db.Decimal(12, 2)
  totalCost    Decimal?                        @db.Decimal(14, 2)
  delivery     OutgoingDelivery                @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  sku          Sku?                            @relation(fields: [skuId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  operations   OutgoingDeliveryItemOperation[]

  @@index([deliveryId])
  @@map("OutgoingDeliveryItems")
}

/// Переопределяемый (относительно дефолта из SKU) состав операций по позиции ИСП.
model OutgoingDeliveryItemOperation {
  id          Int                  @id @default(autoincrement())
  itemId      Int
  operationId Int
  value       String?              @db.NVarChar(100)
  done        Boolean              @default(false)
  factQty     Int?
  executedBy  String?              @db.NVarChar(255)
  executedAt  DateTime?            @db.DateTime2
  item        OutgoingDeliveryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  operation   Operation            @relation(fields: [operationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([itemId, operationId])
  @@index([itemId])
  @@map("OutgoingDeliveryItemOperations")
}

/// Инвентаризация — по инициативе партнёра или внутренняя.
model InventoryTask {
  id        Int                     @id @default(autoincrement())
  number    String                  @unique @db.NVarChar(50) // "ИНВ-123"
  partnerId Int? // null — внутренняя инвентаризация
  source    String                  @db.NVarChar(20) // PARTNER | INTERNAL
  status    String                  @default("Создана") @db.NVarChar(20)
  createdBy String                  @db.NVarChar(255)
  createdAt DateTime                @default(now()) @db.DateTime2
  updatedAt DateTime                @updatedAt @db.DateTime2
  partner   Partner?                @relation(fields: [partnerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items     InventoryTaskItem[]
  executors InventoryTaskExecutor[]

  @@index([partnerId])
  @@map("InventoryTasks")
}

model InventoryTaskItem {
  id          Int           @id @default(autoincrement())
  taskId      Int
  skuId       Int?
  article     String        @db.NVarChar(100)
  name        String?       @db.NVarChar(500)
  address     String?       @db.NVarChar(100) // ячейка хранения на момент снимка остатков
  expectedQty Int // снимок остатка на момент создания задания
  countedQty  Int?
  countedBy   String?       @db.NVarChar(255)
  countedAt   DateTime?     @db.DateTime2
  task        InventoryTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sku         Sku?          @relation(fields: [skuId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId])
  @@map("InventoryTaskItems")
}

/// Кому из сотрудников назначено задание — задание может выполнять несколько человек.
model InventoryTaskExecutor {
  id         Int           @id @default(autoincrement())
  taskId     Int
  employeeId String        @db.NVarChar(50)
  addedAt    DateTime      @default(now()) @db.DateTime2
  task       InventoryTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, employeeId])
  @@map("InventoryTaskExecutors")
}
